# Copy to .env and fill in the blanks. Never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DEBUG=true
ENVIRONMENT_NAME=DEV
ALLOWED_HOSTS=localhost,127.0.0.1,backend
FRONTEND_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080
ADMIN_URL=admin/
LOG_LEVEL=INFO

# Database / cache (service names from compose.yaml)
DATABASE_URL=postgres://govassist:govassist@db:5432/govassist
POSTGRES_DB=govassist
POSTGRES_USER=govassist
POSTGRES_PASSWORD=govassist
REDIS_URL=redis://redis:6379/0
# Host ports published in dev (compose.override.yaml); tests connect to DB_HOST_PORT
DB_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8000

# Gemini (author provides the key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
EMBED_CONCURRENCY=8
LLM_TIMEOUT_S=40
LLM_MAX_OUTPUT_TOKENS=1500
LLM_TEMPERATURE=0.1
LLM_THINKING_LEVEL=low

# RAG / chat
RAG_TOP_K_VECTOR=8
RAG_TOP_K_KEYWORD=8
RAG_FINAL_K=5
RAG_MAX_PER_DOC=2
PROMPT_VERSION=v1
CORPUS_VERSION=2026.10
QUESTION_MAX_CHARS=1000
HISTORY_TURNS=4
CHAT_LIMIT_HOUR=20
CHAT_LIMIT_DAY=100
GLOBAL_DAILY_TOKEN_CAP=2000000

# Auth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Cloudflare's always-pass test secret (dev only)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=GovAssist <no-reply@example.com>

# Collector
CRAWLER_USER_AGENT=GovAssist-research/1.0 (+https://github.com/mashkhurbek-mashrabov/govassist)
CRAWLER_RATE_PER_HOST=1
COLLECTOR_LLM_MAX_TRIES=5
RAW_DATA_DIR=/data/raw

# Prod only
TUNNEL_TOKEN=
