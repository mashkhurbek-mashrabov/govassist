# GovAssist web: serves the SPA and proxies the backend on one origin (plan §10).
# Rendered by the image's envsubst step: ${BACKEND_HOST} and ${ADMIN_URL} come from the environment.

# Docker's embedded DNS, so nginx starts even before the backend container resolves.
resolver 127.0.0.11 valid=30s ipv6=off;

# Real client IP from Cloudflare (cloudflared runs inside the private Docker networks).
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
real_ip_header CF-Connecting-IP;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    set $backend "http://${BACKEND_HOST}";

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    # $http_host keeps the port (localhost:8080), so allauth builds the registered OAuth redirect_uri;
    # behind Cloudflare it is the public domain.
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # SSE: no buffering or caching, long reads (contract §4).
    location = /api/v1/chat {
        proxy_pass $backend;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    location /api/ {
        proxy_pass $backend;
    }

    location /_allauth/ {
        proxy_pass $backend;
    }

    # Google's OAuth redirect lands on allauth's provider callback (/accounts/google/login/callback/).
    location /accounts/ {
        proxy_pass $backend;
    }

    location /static/ {
        proxy_pass $backend;
    }

    location /${ADMIN_URL} {
        proxy_pass $backend;
    }

    # Hashed build assets never change.
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # SPA fallback; index.html is always revalidated.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
